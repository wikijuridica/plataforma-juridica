{
  "format": "jsonl_file_store_v1",
  "dependency_policy": "stdlib_only_no_external_database_dependency",
  "production_cpu_policy": "append_only_small_records_no_runtime_full_scan",
  "separates_source_audit_from_editorial": true,
  "separates_term_seed_from_public_content": true,
  "content_start_policy": "term_ingestion_may_seed_draft_only_until_editorial_source_quality_and_seo_gates_pass",
  "layers": [
    {
      "name": "term_seeds",
      "path": "data/terms/legal_terms.jsonl",
      "record_type": "legal_term_seed",
      "record_max_bytes": 8192,
      "public_indexable": false,
      "allows_raw_official_text": false,
      "allows_editorial_content": false,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Banco leve de termos juridicos para iniciar rascunhos; nao publica, nao indexa e nao guarda texto oficial bruto."
    },
    {
      "name": "source_audits",
      "path": "data/source-audit/robots_terms.jsonl",
      "record_type": "source_audit_event",
      "record_max_bytes": 8192,
      "public_indexable": false,
      "allows_raw_official_text": false,
      "allows_editorial_content": false,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Eventos de auditoria de robots, termos de uso, alcance HTTP e decisao de bloqueio ou desbloqueio."
    },
    {
      "name": "source_snapshots",
      "path": "data/source-snapshots/payloads.jsonl",
      "record_type": "source_payload_snapshot",
      "record_max_bytes": 16384,
      "public_indexable": false,
      "allows_raw_official_text": true,
      "allows_editorial_content": false,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Snapshots autorizados e pequenos, com hash e proveniencia; nao viram conteudo publico diretamente."
    },
    {
      "name": "editorial_drafts",
      "path": "data/editorial/drafts.jsonl",
      "record_type": "editorial_draft",
      "record_max_bytes": 32768,
      "public_indexable": false,
      "allows_raw_official_text": false,
      "allows_editorial_content": true,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Rascunhos editoriais proprios em PT-BR, sempre noindex ate revisao, fonte e qualidade passarem."
    },
    {
      "name": "review_queue",
      "path": "data/editorial/review_queue.jsonl",
      "record_type": "editorial_review_queue",
      "record_max_bytes": 8192,
      "public_indexable": false,
      "allows_raw_official_text": false,
      "allows_editorial_content": false,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Fila editorial de revisao com historico; nao publica, nao indexa e nao cria URL publica."
    },
    {
      "name": "approved_drafts",
      "path": "data/editorial/approved_drafts.jsonl",
      "record_type": "editorial_approval_record",
      "record_max_bytes": 8192,
      "public_indexable": false,
      "allows_raw_official_text": false,
      "allows_editorial_content": false,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Aprovacao editorial ainda sem publicacao; nao indexa, nao cria URL e nao entra em sitemap."
    },
    {
      "name": "publication_blockers",
      "path": "data/editorial/publication_blockers.jsonl",
      "record_type": "publication_blocker_manifest",
      "record_max_bytes": 8192,
      "public_indexable": false,
      "allows_raw_official_text": false,
      "allows_editorial_content": false,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Manifesto de requisitos faltantes antes de qualquer URL publica."
    },
    {
      "name": "published_manifest",
      "path": "data/editorial/published_manifest.jsonl",
      "record_type": "published_content_manifest",
      "record_max_bytes": 8192,
      "public_indexable": false,
      "allows_raw_official_text": false,
      "allows_editorial_content": false,
      "requires_source_provenance": true,
      "requires_quality_state": true,
      "description": "Manifesto leve de conteudo aprovado; paginas publicas continuam sendo renderizadas pelo pipeline proprio."
    }
  ]
}
